<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F172A" 
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Top Header Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="24dp">
            
            <!-- Play Icon (Neon Purple) -->
            <TextView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_rec_btn"
                android:backgroundTint="#8B5CF6"
                android:gravity="center"
                android:text="▶"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:layout_marginEnd="16dp"/>
                
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Streaming Settings"
                    android:textColor="#FFFFFF"
                    android:textSize="22sp"
                    android:textStyle="bold"/>
                    
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Choose the best quality for your needs"
                    android:textColor="#94A3B8"
                    android:textSize="12sp"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Quick Presets Section (Dark Card) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_floating_glass"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_marginBottom="20dp">
            
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚡ Quick Presets"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp"/>
                
            <Spinner
                android:id="@+id/spinnerPreset"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="#1E293B"
                android:popupBackground="#1E293B"
                android:textColor="#FFFFFF"
                android:entries="@array/preset_options"
                android:layout_marginBottom="8dp"/>
        </LinearLayout>

        <!-- Video Settings Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_floating_glass"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_marginBottom="20dp">
            
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🎥 Video Settings"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Adjust resolution, bitrate and FPS"
                android:textColor="#94A3B8"
                android:textSize="11sp"
                android:layout_marginBottom="16dp"/>

            <!-- Resolution -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📺 Resolution"
                android:textColor="#E2E8F0"
                android:textSize="13sp"
                android:layout_marginBottom="6dp"/>
            <Spinner
                android:id="@+id/spinnerResolution"
                android:layout_width="match_parent"
                android:layout_height="45dp"
                android:background="#1E293B"
                android:popupBackground="#1E293B"
                android:textColor="#FFFFFF"
                android:entries="@array/resolution_options"
                android:layout_marginBottom="12dp"/>

            <!-- Bitrate -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📊 Bitrate (Control Size)"
                android:textColor="#E2E8F0"
                android:textSize="13sp"
                android:layout_marginBottom="6dp"/>
            <Spinner
                android:id="@+id/spinnerBitrate"
                android:layout_width="match_parent"
                android:layout_height="45dp"
                android:background="#1E293B"
                android:popupBackground="#1E293B"
                android:textColor="#FFFFFF"
                android:entries="@array/bitrate_options"
                android:layout_marginBottom="12dp"/>

            <!-- FPS -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📚 FPS (Frames Per Second)"
                android:textColor="#E2E8F0"
                android:textSize="13sp"
                android:layout_marginBottom="6dp"/>
            <Spinner
                android:id="@+id/spinnerFps"
                android:layout_width="match_parent"
                android:layout_height="45dp"
                android:background="#1E293B"
                android:popupBackground="#1E293B"
                android:textColor="#FFFFFF"
                android:entries="@array/fps_options"/>
        </LinearLayout>

        <!-- Audio Settings Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_floating_glass"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_marginBottom="30dp">
            
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔊 Audio Setup"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Choose audio source"
                android:textColor="#94A3B8"
                android:textSize="11sp"
                android:layout_marginBottom="12dp"/>
                
            <Spinner
                android:id="@+id/spinnerAudio"
                android:layout_width="match_parent"
                android:layout_height="45dp"
                android:background="#1E293B"
                android:popupBackground="#1E293B"
                android:textColor="#FFFFFF"
                android:entries="@array/audio_options"/>
        </LinearLayout>

        <!-- Glow Start Button -->
        <Button
            android:id="@+id/btnStart"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="▶  SHOW FLOATING BUTTON"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:backgroundTint="#3B82F6"
            android:layout_marginBottom="20dp"/>
            
    </LinearLayout>
</ScrollView>
